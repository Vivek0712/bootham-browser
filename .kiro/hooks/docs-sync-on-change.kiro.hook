{
  "enabled": true,
  "name": "Documentation Sync",
  "description": "Listens for changes to source files (*.ts, *.js, *.py, *.java, *.go, *.rs, *.cpp, *.c, *.h, package.json, requirements.txt, go.mod, Cargo.toml) and asks the agent to update relevant documentation in README.md or /docs folder",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.ts",
      "*.tsx",
      "*.js",
      "*.jsx",
      "*.py",
      "*.java",
      "*.go",
      "*.rs",
      "*.cpp",
      "*.c",
      "*.h",
      "*.hpp",
      "package.json",
      "requirements.txt",
      "go.mod",
      "Cargo.toml",
      "pyproject.toml"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Source code has been modified. Please review the changes and update the documentation accordingly. If a README.md exists, update it. If a /docs folder exists, update the relevant documentation files there. Ensure the documentation accurately reflects the current codebase, including any new features, changed APIs, or updated usage examples."
  }
}